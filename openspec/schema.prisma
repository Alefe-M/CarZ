// CarZ - Prisma Database Schema for PostgreSQL
// OpenSpec: 07. Multi-tenant Database Schema Specification (Gastos Diretos com Peças e Serviços por Veículo)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum GarageRole {
  OWNER       // Dono/Criador da garagem (acesso irrestrito e faturamento)
  ADMIN       // Administrador delegado
  GERENTE     // Gestor de compras, vendas e pátio
  VENDEDOR    // Consulta estoque e registra propostas/vendas
  MECANICO    // Registra serviços e peças aplicadas
  VIEWER      // Somente leitura (auditor/contador)
}

enum InviteStatus {
  PENDENTE
  ACEITO
  RECUSADO
  EXPIRADO
}

enum VehicleStatus {
  PREPARACAO   // 1ª Etapa: Oficina, funilaria, mecânica, peças e higienização
  A_VENDA      // 2ª Etapa: Pronto no pátio, anunciado e disponível para clientes
  VENDIDO      // 3ª Etapa: Negociação concluída, faturado e entregue
}

enum VehicleAcquisitionType {
  COMPRA_DIRETA_PF
  COMPRA_DIRETA_PJ
  LEILAO
  TROCA_TRADE_IN
  CONSIGNADO
}

enum FuelType {
  FLEX
  GASOLINA
  ETANOL
  DIESEL
  HIBRIDO
  ELETRICO
  GNV
}

enum TransmissionType {
  MANUAL
  AUTOMATICO
  AUTOMATIZADO
  CVT
}

enum ExpenseCategory {
  MANUTENCAO_MECANICA       // Troca de peças + mão de obra mecânica
  FUNILARIA_PINTURA         // Lanternagem, pintura, martelinho
  ESTETICA_HIGIENIZACAO     // Lavagem detalhada, polimento, higienização
  DOCUMENTACAO_TAXAS        // IPVA, licenciamento, transferência, despachante
  LAUDO_VISTORIA            // Cautelar, perícia, vistoria
  TRANSPORTE_GUINCHO        // Frete, guincho, combustível
  OUTRO_DIRETO
}

enum GeneralExpenseCategory {
  ALUGUEL_CONDOMINIO
  ENERGIA_AGUA_INTERNET
  MARKETING_ANUNCIOS
  SALARIOS_PRO_LABORE
  COMISSOES_GERAIS
  FERRAMENTAS_EQUIPAMENTOS
  SOFTWARES_SISTEMAS
  IMPOSTOS_TAXAS_EMPRESARIAIS
  CONTABILIDADE_JURIDICO
  MANUTENCAO_PREDIO_LOJA
  OUTRO_GERAL
}

enum PaymentMethod {
  A_VISTA_PIX
  A_VISTA_TED
  FINANCIAMENTO
  CARTAO_CREDITO
  CARTA_CONSORCIO
  VEICULO_TROCA
  MISTO
}

enum PaymentStatus {
  PENDENTE
  PAGO
  CANCELADO
  REEMBOLSADO
}

// ==========================================
// TENANT & CORE USER MODELS
// ==========================================

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  passwordHash  String
  phone         String?
  avatarUrl     String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  memberships   GarageMember[]
  sentInvites   GarageInvite[]

  vehicleExpenses VehicleExpense[]
  sales          SaleTransaction[]

  @@map("users")
}

model Garage {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  documentCnpjCpf String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?         @db.VarChar(2)
  logoUrl         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members         GarageMember[]
  invites         GarageInvite[]

  vehicles        Vehicle[]
  vehicleExpenses VehicleExpense[]
  generalExpenses GeneralExpense[]
  sales           SaleTransaction[]
  customers       Customer[]
  suppliers       Supplier[]

  @@map("garages")
}

model GarageMember {
  id          String      @id @default(uuid())
  garageId    String
  garage      Garage      @relation(fields: [garageId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        GarageRole  @default(VENDEDOR)
  joinedAt    DateTime    @default(now())

  @@unique([garageId, userId])
  @@index([userId])
  @@index([garageId])
  @@map("garage_members")
}

model GarageInvite {
  id              String        @id @default(uuid())
  garageId        String
  garage          Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  email           String
  role            GarageRole    @default(VENDEDOR)
  status          InviteStatus  @default(PENDENTE)
  invitedByUserId String
  invitedByUser   User          @relation(fields: [invitedByUserId], references: [id])
  token           String        @unique
  expiresAt       DateTime
  createdAt       DateTime      @default(now())

  @@index([garageId])
  @@index([email])
  @@map("garage_invites")
}

// ==========================================
// DOMAIN MODELS (SCOPED BY GARAGE / TENANT)
// ==========================================

model Customer {
  id              String          @id @default(uuid())
  garageId        String
  garage          Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  name            String
  documentCpfCnpj String
  email           String?
  phone           String
  address         String?
  city            String?
  state           String?         @db.VarChar(2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  sales           SaleTransaction[]

  @@unique([garageId, documentCpfCnpj])
  @@index([garageId])
  @@map("customers")
}

model Supplier {
  id              String          @id @default(uuid())
  garageId        String
  garage          Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  tradeName       String
  legalName       String?
  documentCnpjCpf String?
  contactPhone    String
  email           String?
  category        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vehicles        Vehicle[]
  vehicleExpenses VehicleExpense[]
  generalExpenses GeneralExpense[]

  @@index([garageId])
  @@map("suppliers")
}

model Vehicle {
  id                      String                  @id @default(uuid())
  garageId                String
  garage                  Garage                  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  plate                   String                  @db.VarChar(7)
  vin                     String                  @db.VarChar(17)
  renavam                 String                  @db.VarChar(11)
  brand                   String
  model                   String
  version                 String?
  yearManufacture         Int
  yearModel               Int
  color                   String
  fuelType                FuelType                @default(FLEX)
  transmission            TransmissionType        @default(MANUAL)
  mileageIn               Int
  mileageCurrent          Int
  status                  VehicleStatus           @default(PREPARACAO)
  acquisitionType         VehicleAcquisitionType  @default(COMPRA_DIRETA_PF)
  acquisitionDate         DateTime                @db.Date
  acquisitionPrice        Decimal                 @db.Decimal(12, 2)
  
  // Integração com Tabela FIPE
  fipeCode                String?                 @db.VarChar(10)
  fipePriceAtAcquisition  Decimal?                @db.Decimal(12, 2)
  fipeReferenceMonth      String?                 @db.VarChar(30)
  
  targetSalePrice         Decimal?                @db.Decimal(12, 2)
  minimumSalePrice        Decimal?                @db.Decimal(12, 2)
  notes                   String?                 @db.Text
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  supplierId              String?
  supplier                Supplier?               @relation(fields: [supplierId], references: [id])

  expenses                VehicleExpense[]
  sale                    SaleTransaction?

  tradeInFromSaleId       String?                 @unique
  tradeInFromSale         SaleTransaction?        @relation("TradeInVehicle", fields: [tradeInFromSaleId], references: [id])

  @@unique([garageId, plate])
  @@unique([garageId, vin])
  @@index([garageId, status])
  @@map("vehicles")
}

model VehicleExpense {
  id                  String            @id @default(uuid())
  garageId            String
  garage              Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicleId           String
  vehicle             Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category            ExpenseCategory
  description         String
  
  // Detalhamento de Peça vs Mão de Obra / Serviço:
  partsCost           Decimal           @default(0) @db.Decimal(12, 2) // Valor das Peças (ex: R$ 20,00)
  laborCost           Decimal           @default(0) @db.Decimal(12, 2) // Valor da Mão de Obra/Serviço (ex: R$ 50,00)
  amount              Decimal           @db.Decimal(12, 2)             // Total (ex: R$ 70,00)
  
  expenseDate         DateTime          @db.Date
  paymentStatus       PaymentStatus     @default(PAGO)
  receiptFileUrl      String?
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())

  supplierId          String?
  supplier            Supplier?         @relation(fields: [supplierId], references: [id])

  createdByUserId     String
  createdByUser       User              @relation(fields: [createdByUserId], references: [id])

  @@index([garageId])
  @@index([vehicleId])
  @@map("vehicle_expenses")
}

model GeneralExpense {
  id                String                  @id @default(uuid())
  garageId          String
  garage            Garage                  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  category          GeneralExpenseCategory
  description       String
  amount            Decimal                 @db.Decimal(12, 2)
  dueDate           DateTime                @db.Date
  paymentDate       DateTime?               @db.Date
  paymentStatus     PaymentStatus           @default(PENDENTE)
  isRecurring       Boolean                 @default(false)
  recurrencePeriod  String?
  documentNumber    String?
  notes             String?                 @db.Text
  createdAt         DateTime                @default(now())

  supplierId        String?
  supplier          Supplier?               @relation(fields: [supplierId], references: [id])

  @@index([garageId])
  @@map("general_expenses")
}

model SaleTransaction {
  id                    String          @id @default(uuid())
  garageId              String
  garage                Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  vehicleId             String          @unique
  vehicle               Vehicle         @relation(fields: [vehicleId], references: [id])
  customerId            String
  customer              Customer        @relation(fields: [customerId], references: [id])
  sellerUserId          String
  sellerUser            User            @relation(fields: [sellerUserId], references: [id])
  saleDate              DateTime        @db.Date
  finalSalePrice        Decimal         @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  cashAmount            Decimal         @default(0) @db.Decimal(12, 2)
  financedAmount        Decimal         @default(0) @db.Decimal(12, 2)
  salesCommissionAmount Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal         @default(0) @db.Decimal(12, 2)
  otherDeductions       Decimal         @default(0) @db.Decimal(12, 2)

  tradeInValue          Decimal         @default(0) @db.Decimal(12, 2)
  tradeInVehicle        Vehicle?        @relation("TradeInVehicle")

  totalAccumulatedCost  Decimal         @db.Decimal(12, 2)
  grossProfit           Decimal         @db.Decimal(12, 2)
  netProfit             Decimal         @db.Decimal(12, 2)
  notes                 String?         @db.Text
  createdAt             DateTime        @default(now())

  @@index([garageId])
  @@map("sale_transactions")
}
